{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Application Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"tinypay-backend\"}", "legendFormat": "backend" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "HTTP Requests / sec",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "RPS" }
      ]
    },
    {
      "type": "stat",
      "title": "HTTP 5xx Rate",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_server_requests_seconds_count[1m])), 0.001)",
          "legendFormat": "5xx rate"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "stat",
      "title": "JVM Heap Used",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "stat",
      "title": "DB Active Connections",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "active" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Backend Response Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum[1m])) by (uri) / clamp_min(sum(rate(http_server_requests_seconds_count[1m])) by (uri), 0.001)",
          "legendFormat": "{{uri}} average"
        },
        {
          "expr": "max(http_server_requests_seconds_max) by (uri)",
          "legendFormat": "{{uri}} max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "HikariCP Connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "active" },
        { "expr": "hikaricp_connections_idle", "legendFormat": "idle" },
        { "expr": "hikaricp_connections_pending", "legendFormat": "pending" },
        { "expr": "hikaricp_connections_max", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM CPU and GC",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "process_cpu_usage", "legendFormat": "process CPU" },
        { "expr": "rate(jvm_gc_pause_seconds_sum[1m])", "legendFormat": "GC pause / sec" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "timeseries",
      "title": "k6 Request Duration",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "k6_http_req_duration_p95",
          "legendFormat": "p95 {{name}}"
        },
        {
          "expr": "k6_http_req_duration_p99",
          "legendFormat": "p99 {{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "timeseries",
      "title": "k6 Throughput and Failures",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        { "expr": "rate(k6_http_reqs_total[1m])", "legendFormat": "requests/sec" },
        { "expr": "k6_http_req_failed_rate", "legendFormat": "failure rate" },
        { "expr": "k6_vus", "legendFormat": "virtual users" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["tinypay", "performance", "k6"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "TinyPay Performance",
  "uid": "tinypay-performance",
  "version": 1
}
